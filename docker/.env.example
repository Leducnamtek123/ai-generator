# Public URLs
APP_URL=http://localhost:3000
API_BACKEND_URL=http://localhost:8000/api/v1
BILLING_API_URL=http://localhost:8001/api/v1
GENERATION_API_URL=http://localhost:8002/api/v1

# Runtime mode
COMPOSE_PROFILES=
DB_TYPE=postgres
VECTOR_STORE=none

# Core infrastructure
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ai_generator
DATABASE_SYNCHRONIZE=false
DATABASE_SSL_ENABLED=false
DATABASE_MAX_CONNECTIONS=100

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
WORKER_HOST=redis://redis:6379/1

POSTGRES_PORT=5432
MYSQL_PORT=3306

# Object storage
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=ai-generator
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Security / proxy
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
ENABLE_HTTPS=false
SSRF_PROXY_PORT=3128

# Optional services
PLUGIN_DAEMON_URL=http://plugin_daemon:5003
SANDBOX_URL=http://sandbox:8194

# App defaults
APP_MODE=api
APP_PORT=8000
NODE_ENV=development
