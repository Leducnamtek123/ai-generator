# Project configuration
DATABASE_NAME=paintai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SYNCHRONIZE=false
DATABASE_SSL_ENABLED=false
DATABASE_MAX_CONNECTIONS=100

# Storage
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=ai-generator
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Services configuration
COMPOSE_PROFILES=
NODE_ENV=development
ENABLE_HTTPS=false

# Local GPU generation via ComfyUI
# Current repo baseline for a 16GB GPU: Z-Image-Turbo for image generation, plus Wan 2.1 1.3B for video.
# SDXL base 1.0 stays available as a fallback preset.
# IMAGE_GEN_PROVIDER=comfyui
# IMAGE_GEN_MODEL=z_image_turbo_bf16.safetensors
# VIDEO_GEN_PROVIDER=comfyui
# VIDEO_GEN_MODEL=wan2.1_t2v_1.3B_fp16.safetensors
# COMFYUI_BASE_URL=http://comfyui:8188
# COMFYUI_PUBLIC_BASE_URL=http://localhost:8188
# COMFYUI_IMAGE_WORKFLOW_PATH=/workspace/comfyui-workflows/image_z_image_turbo_text_to_image.json
# COMFYUI_IMAGE_WORKFLOW_ZIMAGE_PATH=/workspace/comfyui-workflows/image_z_image_turbo_text_to_image.json
# COMFYUI_IMAGE_WORKFLOW_SDXL_PATH=/workspace/comfyui-workflows/image_sdxl_text_to_image.json
# COMFYUI_VIDEO_WORKFLOW_PATH=/workspace/comfyui-workflows/text_to_video_wan.json

# Ports and host overrides (uncomment to change defaults)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# API_BACKEND_URL=http://api:8000/api/v1
# BILLING_API_URL=http://billing-service:8001/api/v1
# GENERATION_API_URL=http://generation-service:8002/api/v1

# Mail
MAIL_HOST=maildev
MAIL_PORT=1025
