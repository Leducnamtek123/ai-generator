# Project configuration
DATABASE_NAME=paintai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SYNCHRONIZE=false
DATABASE_SSL_ENABLED=false
DATABASE_MAX_CONNECTIONS=100

# Storage
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=ai-generator
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Services configuration
COMPOSE_PROFILES=
NODE_ENV=development
ENABLE_HTTPS=false

# Ports and host overrides (uncomment to change defaults)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# API_BACKEND_URL=http://api:8000/api/v1
# BILLING_API_URL=http://billing-service:8001/api/v1
# GENERATION_API_URL=http://generation-service:8002/api/v1
