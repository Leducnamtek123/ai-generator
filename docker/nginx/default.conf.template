server {
  listen 80;
  server_name _;
  resolver 127.0.0.11 ipv6=off valid=10s;

  # Direct access to versioned API
  location /api/v1/ {
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
  }

  # Socket.IO gateway for social hub realtime updates
  location ^~ /socket.io/ {
    set $api_upstream http://api:8000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
    proxy_pass $api_upstream;
  }

  # Compatibility for old console routes
  location /console/api/ {
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
  }

  # Static files from API
  location /files/ {
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
  }

  # Triggers
  location /triggers/ {
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
  }

  # 9Pay IPN Callback (Redirected to main API)
  location /webhooks/9pay/ipn {
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
  }

  # Everything else (including /api/auth and other /api/ routes) goes to Frontend
  location / {
    set $web_upstream http://web:3000;
    proxy_pass $web_upstream;
  }
}
