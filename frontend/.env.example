# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional locale-specific domains
# NEXT_PUBLIC_SITE_URL_EN=https://paintai.com
# NEXT_PUBLIC_SITE_URL_VI=https://vi.paintai.com

# Auth
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# API - Backend (public nginx origin, prefix api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BILLING_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_GENERATION_API_URL=http://localhost:8002/api/v1

# GitHub URL
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/ai-generator

# Analytics (optional) — e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
